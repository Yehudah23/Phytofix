{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/Phytofix/browser",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://phytofix-backend.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://phytofix-backend.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/team/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
